NODE_ENV=development
PORT=4007
FRONTEND_ORIGIN=http://localhost:4000
STORE_URL=http://localhost:4000

DB_HOST=localhost
DB_PORT=5433
DB_USER=bubble
DB_PASSWORD=bubble
DB_NAME=bubble_store
# Em producao, DATABASE_URL substitui as cinco variaveis DB_* acima.
DATABASE_URL=
DB_SSL=false
DB_MIGRATIONS_RUN=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=troque-este-segredo-em-producao
LOGIN_CODE_SECRET=use-outro-segredo-aleatorio-em-producao
MANAGER_EMAIL=gerente@bubble.com.br

PIX_DISCOUNT=0.05
BUNDLE_DISCOUNT=0.05
FREE_SHIPPING_ENABLED=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@wearbubble.com.br
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contato@wearbubble.com.br
SMTP_FROM_NAME=Wear Bubble
LINKETRACK_USER=
LINKETRACK_TOKEN=
MP_ACCESS_TOKEN=

# Use "production" somente no deploy com um token de producao.
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
# Opcional: se estiver vazia, a API consulta ou cria a chave publica no PagBank.
PAGBANK_PUBLIC_KEY=
PAGBANK_WEBHOOK_URL=http://localhost:4007/api/payment/webhook/pagbank
PAGBANK_INSTALLMENTS=3

MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://seu-tunel.trycloudflare.com/api/integrations/melhor-envio/oauth/callback
MELHOR_ENVIO_USER_AGENT=Wear Bubble (contato@wearbubble.com.br)
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=
